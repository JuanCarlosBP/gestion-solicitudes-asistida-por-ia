{
  "name": "gestion-solicitudes-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e playwright.config.ts --max-warnings=0",
    "format:check": "prettier --check src e2e playwright.config.ts *.json *.mjs .prettierrc",
    "format": "prettier --write src e2e playwright.config.ts *.json *.mjs .prettierrc"
  },
  "description": "Base técnica de Gestión de Solicitudes",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
