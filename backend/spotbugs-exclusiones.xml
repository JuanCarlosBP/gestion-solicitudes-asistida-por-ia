<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- HttpSecurity.build y sus configuradores declaran Exception en su API.
       No se puede estrechar la firma del factory sin ocultar el fallo de arranque. -->
  <Match>
    <Class name="es.gestionsolicitudes.configuracion.SeguridadTecnica"/>
    <Method name="cadenaTecnica"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>
  <!-- El DataSource es un recurso compartido administrado por Spring/Hikari.
       Copiarlo rompería el ciclo de vida del pool. No se expone con un getter. -->
  <Match>
    <Class name="es.gestionsolicitudes.salud.persistencia.ComprobacionPostgres"/>
    <Method name="&lt;init&gt;" params="javax.sql.DataSource"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- El puerto es un colaborador de persistencia administrado por Spring, no
       datos mutables recibidos del cliente. Debe compartir el DataSource y la
       transacción; no existe copia defensiva válida de un repositorio JDBC.
       El campo es final, privado y no tiene getter ni setter. Se conserva el
       análisis para todos los demás campos, métodos y clases. -->
  <Match>
    <Class name="es.gestionsolicitudes.proveedores.aplicacion.ServicioProveedores"/>
    <Method name="&lt;init&gt;" params="es.gestionsolicitudes.proveedores.aplicacion.RepositorioProveedores,java.time.Clock,org.springframework.transaction.PlatformTransactionManager,es.gestionsolicitudes.operaciones.aplicacion.ServicioOperaciones,es.gestionsolicitudes.historial.aplicacion.RegistroHistorial"/>
    <Field name="repositorio"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Mismo puerto JDBC compartido por Spring: copiarlo separaría la transacción
       de negocio del registro de historial. Campos privados/finales sin acceso
       público; exclusiones limitadas a su inyección, no a datos de las respuestas. -->
  <Match>
    <Class name="es.gestionsolicitudes.historial.aplicacion.RegistroHistorial"/>
    <Method name="&lt;init&gt;" params="es.gestionsolicitudes.historial.aplicacion.RepositorioHistorial"/>
    <Field name="repositorio"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="es.gestionsolicitudes.historial.aplicacion.ServicioHistorial"/>
    <Method name="&lt;init&gt;" params="es.gestionsolicitudes.historial.aplicacion.RepositorioHistorial,es.gestionsolicitudes.operaciones.aplicacion.RepositorioOperaciones,org.springframework.transaction.PlatformTransactionManager"/>
    <Field name="repositorio"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
